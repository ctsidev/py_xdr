-- PROC
DROP TABLE xdr_<<PROJECT_ID>>_proc PURGE;
CREATE TABLE xdr_<<PROJECT_ID>>_proc AS
SELECT DISTINCT t.pat_id
    ,t.pat_mrn_id
    ,t.ip_patient_id
    ,cpt.pat_enc_csn_id
    ,cpt.contact_date                   PROCEDURE_DATE
    ,'CPT-preCC'                        PROCEDURE_TYPE
    ,cpt.cpt_code                       PROCEDURE_CODE 
    ,eap.proc_name                      PROCEDURE_DESCRIPTION
    ,floor(months_between(contact_date, dob) / 12) procedure_age
FROM xdr_<<PROJECT_ID>>_<<LINK_TBL>>        t
JOIN i2b2.int_cpt                           cpt ON t.<<LINK_COL>> = cpt.<<LINK_COL>>
LEFT JOIN clarity_eap                       eap ON cpt.cpt_code = eap.proc_code
where cpt.contact_date <<DATE_RANGE>>
UNION
SELECT DISTINCT t.pat_id
    ,t.pat_mrn_id
    ,t.ip_patient_id
    ,cpt.pat_enc_csn_id
    ,cpt.contact_date                   proc_date
    ,'CPT-'||cpt.source                 proc_type
    ,cpt.cpt_code                       proc_code 
    ,eap.proc_name 
    ,floor(months_between(contact_date, dob) / 12) procedure_age
FROM xdr_<<PROJECT_ID>>_<<LINK_TBL>>        t
JOIN i2b2.lz_clarity_cpt_code               cpt ON t.<<LINK_COL>> = cpt.<<LINK_COL>>
LEFT JOIN clarity_eap                       eap ON cpt.cpt_code = eap.proc_code
where cpt.contact_date <<DATE_RANGE>>
UNION
SELECT DISTINCT t.pat_id
    ,t.pat_mrn_id
    ,t.ip_patient_id
    ,px.pat_enc_csn_id
    ,px.effective_date                  proc_date       
    ,'ICD-9' proc_type
    ,px.icd9_code                       proc_code
    ,icd.icd_desc                       proc_name
    ,floor(months_between(effective_date, dob) / 12) procedure_age
FROM xdr_<<PROJECT_ID>>_<<LINK_TBL>>        t
JOIN i2b2.int_proc                          px ON t.<<LINK_COL>> = px.<<LINK_COL>>
LEFT JOIN i2b2.lz_dx_px_lookup              icd ON px.icd9_code = icd.code
    AND icd.code_type = 'PX' 
    AND icd.icd_type = 9
where px.effective_date <<DATE_RANGE>>
UNION
SELECT DISTINCT t.pat_id
    ,t.pat_mrn_id
    ,t.ip_patient_id
    ,px.pat_enc_csn_id
    ,px.proc_date       
    ,CASE
        WHEN px.icd_code_set = 'ICD-9-CM Volume 3' 
            THEN 'ICD-9'
        WHEN px.icd_code_set = 'ICD-10-PCS' 
            THEN 'ICD-10'
        END                             proc_type
    ,px.px_code                         proc_code
    ,px.procedure_name                  proc_name
    ,floor(months_between(proc_date, dob) / 12) procedure_age
FROM xdr_<<PROJECT_ID>>_<<LINK_TBL>>        t
JOIN i2b2.lz_clarity_procedures             px ON t.<<LINK_COL>> = px.<<LINK_COL>>
where px.proc_date <<DATE_RANGE>>
;

-- PROC W PROV
DROP TABLE xdr_<<PROJECT_ID>>_proc PURGE;
CREATE TABLE xdr_<<PROJECT_ID>>_proc AS
SELECT DISTINCT enc.pat_id
                ,t.pat_mrn_id
                ,t.ip_patient_id
                ,hspt.pat_enc_csn_id
                ,hspt.service_date                  					AS procedure_date               
                ,SUBSTR(COALESCE(hspt.hcpcs_code,hspt.cpt_code),1,5) 	AS procedure_code
                ,'CPT-Hospital'                         				AS procedure_type       
                ,hspt.PERFORMING_PROV_ID
                ,hspt.BILLING_PROV_ID                                   AS BILLING_PROV_ID
        		,EAP.PROC_NAME                                          as procedure_description
FROM i2b2.lz_clarity_enc              	enc
JOIN xdr_<<PROJECT_ID>>_<<LINK_TBL>>    t  ON enc.<<LINK_COL>> = t.<<LINK_COL>>
JOIN hsp_transactions                 	hspt ON enc.pat_enc_csn_id = hspt.pat_enc_csn_id
LEFT OUTER JOIN f_arhb_inactive_tx    	fait ON hspt.tx_id = fait.tx_id
LEFT JOIN clarity_eap                 	eap  ON SUBSTR(COALESCE(hspt.hcpcs_code,hspt.cpt_code),1,5) = eap.proc_code
WHERE hspt.tx_type_ha_c = 1  
          AND (LENGTH(hspt.cpt_code) = 5 OR hspt.hcpcs_code IS NOT NULL)
          AND fait.tx_id IS NULL
          and hspt.service_date <<DATE_RANGE>>
union
SELECT distinct arpb.patient_id AS pat_id
				,t.pat_mrn_id
                ,t.ip_patient_id
				,arpb.pat_enc_csn_id
				,arpb.service_date             	AS proc_date               
				,arpb.cpt_code					AS proc_code
				,'CPT-Professional'            	AS proc_type    
				,arpb.SERV_PROVIDER_ID			AS PERFORMING_PROV_ID
				,arpb.BILLING_PROV_ID           AS BILLING_PROV_ID
				,EAP.PROC_NAME
FROM  i2b2.lz_clarity_enc           enc
JOIN xdr_<<PROJECT_ID>>_<<LINK_TBL>>            t ON enc.<<LINK_COL>> = t.<<LINK_COL>>
JOIN arpb_transactions          arpb ON enc.pat_enc_csn_id = arpb.pat_enc_csn_id
LEFT JOIN clarity_eap eap  ON arpb.cpt_code = eap.proc_code
WHERE tx_type_c = 1					-----  Charges only
		AND void_date IS NULL
        and arpb.service_date <<DATE_RANGE>>
union
SELECT DISTINCT t.pat_id
               ,t.pat_mrn_id
                ,t.ip_patient_id
               ,px.pat_enc_csn_id
               ,px.proc_date       
               ,px.px_code            AS proc_code
               ,CASE
                  WHEN px.icd_code_set = 'ICD-9-CM Volume 3' THEN 'ICD-9'
                  WHEN px.icd_code_set = 'ICD-10-PCS' THEN 'ICD-10'
                END AS proc_type
               ,px.PROC_PERF_PROV_ID
               ,null AS BILLING_PROV_ID
               ,px.procedure_name     AS proc_name
  FROM xdr_<<PROJECT_ID>>_<<LINK_TBL>>                  t
  join i2b2.lz_clarity_enc           enc on enc.<<LINK_COL>> = t.<<LINK_COL>>
  JOIN i2b2.lz_clarity_procedures     px   ON enc.pat_enc_csn_id = px.pat_enc_csn_id
  where px.proc_date <<DATE_RANGE>>
;